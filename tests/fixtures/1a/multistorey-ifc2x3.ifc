#50=IFCRELCONTAINEDINSPATIALSTRUCTURE('0IFC2X3REL000000000AA',$,$,$,(#47),#33);
#51=IFCRELAGGREGATES('0IFC2X3REL000000001AA',$,$,$,#1,(#21));
