{
  "name": "ifccostestimator",
  "version": "0.0.0",
  "description": "Browser-only IFC viewing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\" \".*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\" \".*.json\"",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:coverage": "vitest run --config tests/vitest.config.ts --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "author": "Sourav ganguli",
  "license": "ISC",
  "dependencies": {
    "@fluentui/web-components": "^3.1.3",
    "lucide": "^1.61.0",
    "three": "^0.186.1",
    "web-ifc": "0.0.78"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.183.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
