ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Synthetic model declaring millimetre length units'),'2;1');
FILE_NAME('units-millimetre.ifc','2026-10-27T00:00:00',('Test'),('Test'),'IfcCostEstimator','IfcCostEstimator','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0MMPROJECT0000000000A',$,'Millimetre project',$,$,$,$,(#10),#5);
#2=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#5=IFCUNITASSIGNMENT((#2));
#6=IFCCARTESIANPOINT((0.,0.,0.));
#7=IFCAXIS2PLACEMENT3D(#6,$,$);
#8=IFCDIRECTION((0.,0.,1.));
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#7,$);
#11=IFCCARTESIANPOINT((0.,0.));
#12=IFCAXIS2PLACEMENT2D(#11,$);
#13=IFCRECTANGLEPROFILEDEF(.AREA.,$,#12,4000.,1000.);
#14=IFCEXTRUDEDAREASOLID(#13,#7,#8,3000.);
#15=IFCSHAPEREPRESENTATION(#10,'Body','SweptSolid',(#14));
#16=IFCPRODUCTDEFINITIONSHAPE($,$,(#15));
#17=IFCLOCALPLACEMENT($,#20);
#18=IFCBUILDINGELEMENTPROXY('1MM0000000000000000AA',$,'Millimetre box',$,$,#17,#16,$,.NOTDEFINED.);
#19=IFCCARTESIANPOINT((0.,0.,0.));
#20=IFCAXIS2PLACEMENT3D(#19,$,$);
ENDSEC;
END-ISO-10303-21;
