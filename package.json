{
  "name": "ifccostestimator",
  "version": "0.0.0",
  "description": "Browser-only IFC viewing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts"
  },
  "author": "Sourav ganguli",
  "license": "ISC",
  "dependencies": {
    "lucide": "^1.61.0",
    "three": "^0.186.1",
    "web-ifc": "0.0.78"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.183.0",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
