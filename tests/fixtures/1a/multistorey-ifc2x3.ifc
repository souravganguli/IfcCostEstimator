#64=IFCRELDEFINESBYPROPERTIES('0IFC2X3REL000000004AA',$,$,$,(#47),#63);
#70=IFCPROPERTYSET('0IFC2X3PSET00000000AA',$,'Pset_Empty',$,());
#71=IFCRELDEFINESBYPROPERTIES('0IFC2X3REL000000005AA',$,$,$,(#47),#70);
ENDSEC;
